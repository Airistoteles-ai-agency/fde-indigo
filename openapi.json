                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unknown category or product."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid argument."
